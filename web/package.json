{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3000 -H 0.0.0.0",
    "dev:turbo": "next dev --turbopack -p 3000 -H 0.0.0.0",
    "build": "node scripts/theme-colors.mjs --check && next build && pnpm run sw:compile",
    "sw:compile": "serwist build serwist.config.js",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi:gen": "openapi-typescript lib/api/openapi.json -o lib/api/types.generated.ts",
    "check-bundle-size": "node scripts/check-bundle-size.mjs",
    "check-query-keys": "node scripts/check-query-keys.mjs",
    "check-status-colors": "node scripts/check-status-colors.mjs",
    "check-pwa-assets": "node scripts/check-pwa-assets.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "check-theme-colors": "node scripts/theme-colors.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "6.0.0",
    "@scalar/api-reference-react": "^0.9.42",
    "@serwist/next": "9.5.13",
    "@serwist/window": "9.5.13",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "^3.14.2",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "^1.1.1",
    "cn": "workspace:*",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "^3.8.1",
    "serwist": "9.5.13",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@serwist/cli": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.0.5"
  }
}

# Comic Reader — environment variables
# Copy to .env and edit. See §12.3 of the spec.
# All variables use the COMIC_ prefix.

# ───── Core ─────
COMIC_DATABASE_URL=postgres://comic:comic@localhost:5432/comic_reader
# Required since Library Scanner v1 — apalis-backed background scan and
# post-scan jobs need Redis. Dev compose publishes redis on host port 6380 to
# avoid colliding with a system valkey/redis daemon on 6379. In prod
# (compose.prod.yml) this is just `redis:6379` inside the docker network — see
# compose.prod.yml for the override.
COMIC_REDIS_URL=redis://localhost:6380

# WARNING — the next two paths default to dev locations (relative to the
# repo root). For a docker-compose deployment, **leave them unset** so
# the Dockerfile defaults apply (`COMIC_LIBRARY_PATH=/library`,
# `COMIC_DATA_PATH=/data`). The compose file already mounts the host
# library + named secrets-volume to those exact paths. Setting these to
# `./.dev-data/...` inside a container points the server at an
# ephemeral path in the writable layer — the pepper, JWT key, etc. get
# regenerated on every `docker compose up -d`, which locks every user
# out of their old password hash.
COMIC_LIBRARY_PATH=./fixtures/library
COMIC_DATA_PATH=./.dev-data/app
# Public origin the browser hits. As of v0.2 (rust-public-origin) the
# Rust binary is the public-facing service, so dev defaults to :8080.
# The JWT `iss` claim, the CSP `connect-src` allow-list (including the
# WebSocket origin), and OIDC redirect URIs all derive from this — so
# it must match wherever the browser actually loads the page from.
COMIC_PUBLIC_URL=http://localhost:8080
COMIC_BIND_ADDR=0.0.0.0:8080
COMIC_LOG_LEVEL=info  # DEPRECATED, manage via /admin/server
COMIC_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# ───── Auth mode — DEPRECATED, manage via /admin/auth ─────
# Bootstrapped into `app_setting` on first boot, then ignored on
# subsequent boots. Edit identity config through the admin UI rather
# than this file.
# oidc | local | both
COMIC_AUTH_MODE=both

# ───── OIDC — DEPRECATED, manage via /admin/auth ─────
COMIC_OIDC_ISSUER=http://localhost:5556/dex
COMIC_OIDC_CLIENT_ID=comic-reader
COMIC_OIDC_CLIENT_SECRET=dev-secret-not-for-production
COMIC_OIDC_TRUST_UNVERIFIED_EMAIL=false
# Auto-link a first OIDC login onto the local account with the same
# verified email instead of failing with `auth.email_in_use`. Opt-in: it
# trusts the IdP's `email_verified` claim for account linking.
# COMIC_OIDC_LINK_LOCAL_BY_VERIFIED_EMAIL=false

# ───── Local users — DEPRECATED, manage via /admin/auth ─────
COMIC_LOCAL_REGISTRATION_OPEN=true

# ───── Tokens — DEPRECATED, manage via /admin/auth ─────
COMIC_JWT_ACCESS_TTL=24h
COMIC_JWT_REFRESH_TTL=30d

# ───── Rate limiting — DEPRECATED, manage via /admin/server ─────
# When false, the failed-auth Redis lockout short-circuits (per-route
# governor buckets stay installed; they require a restart to disable).
COMIC_RATE_LIMIT_ENABLED=true

# ───── Server behaviour — DEPRECATED, manage via /admin/server ─────
# Fetch the latest GitHub release once an hour so the admin UI can show
# "vX.Y available". Air-gapped deployments turn it off
# (DB key `updates.check_upstream_releases`).
# COMIC_CHECK_UPSTREAM_RELEASES=true
# OPDS client-compat mode: `off` (spec-clean) or `komga` (feeds present
# as Komga + the Komga REST shim at /api/v1/books/… for Panels /
# Tachiyomi-class progress sync). DB key `compat.opds_panels_mode`.
# COMIC_OPDS_PANELS_MODE=off

# ───── SMTP — DEPRECATED, manage via /admin/email ─────
# These env vars are still read on first boot and bootstrapped into the
# `app_setting` table, then ignored on subsequent boots. After upgrading,
# edit SMTP through the admin UI (`/admin/email`) rather than this file.
# Leave COMIC_SMTP_HOST empty to start in the no-SMTP "noop" mode; you can
# then configure email via the admin UI without restarting.
COMIC_SMTP_HOST=
COMIC_SMTP_PORT=587
COMIC_SMTP_USERNAME=
COMIC_SMTP_PASSWORD=
COMIC_SMTP_TLS=starttls
# COMIC_SMTP_FROM=noreply@example.com  (uncomment + set when SMTP is configured;
# avoid display-name + angle-brackets here — `just` dotenv parser is strict)

# ───── Scan / archive limits (spec §4.1.1) ─────
# DoS bounds applied at archive-open + read-entry time. Defaults are
# generous enough for typical CBZ libraries; harden these on a public-
# facing deployment, or raise them if you have unusually large
# archives. Effective immediately on next scan / page read; unset to
# fall back to the defaults shown.
# COMIC_ARCHIVE_MAX_ENTRIES=50000           # files per archive
# COMIC_ARCHIVE_MAX_TOTAL_BYTES=8589934592  # 8 GiB uncompressed total
# COMIC_ARCHIVE_MAX_ENTRY_BYTES=536870912   # 512 MiB single file
# COMIC_ARCHIVE_MAX_RATIO=200               # zip-bomb compression-ratio guard
# COMIC_ARCHIVE_MAX_NESTING=1               # nested-archive depth

# ───── ZIP LRU — DEPRECATED, manage via /admin/server ─────
# Applies on next restart (the LRU is sized at boot).
# COMIC_ZIP_LRU_CAPACITY=64

# ───── Caches ─────
# Byte budget for the on-disk reader page-variant cache under
# `COMIC_DATA_PATH/cache` (docs/dev/page-variants.md). 0 disables the
# cache — variants are still served, recomputed per request.
# COMIC_PAGE_VARIANT_CACHE_BYTES=2147483648   # 2 GiB
# MiB budget for generated thumbnails under `COMIC_DATA_PATH/thumbs`.
# 0 = unbounded. When set, a sweep evicts least-recently-used strips,
# then covers, down to 90% of the budget; they regenerate on demand.
# DB key `cache.thumbs_budget_mb` (live, read per sweep).
# COMIC_THUMBS_BUDGET_MB=0

# ───── Workers — DEPRECATED, manage via /admin/server ─────
# Apply on next restart (apalis pool size is fixed at startup; live
# pool restart is deferred future work).
# COMIC_DB_MAX_CONNECTIONS=30       # sea-orm pool size (env-only; keep below Postgres max_connections)
# COMIC_SCAN_WORKER_COUNT=8         # parallel scan jobs (default min(cpu, 8))
# COMIC_SCAN_FOLDER_CONCURRENCY=2   # series folders in flight per scan (default 2)
# COMIC_POST_SCAN_WORKER_COUNT=4    # parallel post-scan jobs (default clamp(cpu/2, 2, 8))
# COMIC_SCAN_BATCH_SIZE=100         # issues per DB transaction
# COMIC_SCAN_HASH_BUFFER_KB=1024    # BLAKE3 streaming buffer (default 1024)
# COMIC_ARCHIVE_WORK_PARALLEL=8     # global cap on blocking archive work (default clamp(cpu, 2, 8))
# COMIC_THUMB_INLINE_PARALLEL=8     # cap on on-demand thumbnail generation (default 8)

# ───── File watcher (WP-3.1) ─────
# Timing is managed via /admin/server → File watcher (live, no restart);
# these env values are only the boot default until a DB row exists.
# Per-library on/off is the library's "Watch for file changes" setting.
# COMIC_WATCH_DEBOUNCE_SECS=30        # quiet period before a scoped scan (local disks)
# COMIC_WATCH_POLL_INTERVAL_SECS=300  # directory-mtime poll cadence (NFS/SMB/FUSE)
# Infrastructure override: poll every watched library instead of using
# inotify (for network shares that report a local filesystem type).
# COMIC_WATCH_FORCE_POLL=false

# ───── Library retention ─────
# Hard-purge window multiplier. The daily 04:15 UTC sweep deletes issue /
# empty-series rows whose removal was confirmed more than
# `library.soft_delete_days × this` days ago (default 30 × 2 = 60 days).
# 0 disables purging. DB key `library.hard_purge_multiplier` (live).
# COMIC_LIBRARY_HARD_PURGE_MULTIPLIER=2
# Audit-log retention in days. 0 (default) keeps every admin-action entry
# forever. When set (minimum 90), the daily 03:45 UTC sweep exports entries
# older than this to `COMIC_DATA_PATH/audit-log-exports/*.ndjson` and only
# then deletes them. Managed via /admin/server → Audit log retention; this
# is only the boot default. DB key `audit_log.retention_days` (live).
# COMIC_AUDIT_LOG_RETENTION_DAYS=0

# ───── Migrations ─────
COMIC_AUTO_MIGRATE=true

# ───── CBL catalog refresher ─────
# Optional GitHub PAT for the `/admin/catalog` CBL fetcher. Raises the
# GitHub anonymous rate limit from 60 to 5000 requests/hr, which matters
# when a catalog source pulls many `.cbl` files from a single repo.
# Leave unset for the anonymous limit.
# COMIC_GITHUB_TOKEN=

# ───── Metadata providers — DEPRECATED, manage via /admin/metadata ─────
# First-boot bootstraps into `app_setting`; the DB value wins once saved.
# Secrets are AEAD-sealed at rest. All providers are off by default.
# COMIC_COMICVINE_API_KEY=
# COMIC_COMICVINE_ENABLED=false
# COMIC_METRON_API_TOKEN=              # preferred over username/password
# COMIC_METRON_USERNAME=
# COMIC_METRON_PASSWORD=
# COMIC_METRON_ENABLED=false
# COMIC_GCD_USERNAME=
# COMIC_GCD_PASSWORD=
# COMIC_GCD_ENABLED=false
# Test / staging hooks only — production leaves these unset.
# COMIC_COMICVINE_BASE_URL=https://comicvine.gamespot.com/api
# COMIC_METRON_BASE_URL=https://metron.cloud
# COMIC_GCD_BASE_URL=https://www.comics.org
# Operator-supplied local database files (docs/dev/local-metadata-databases.md).
# Stored and probed; the providers do not read them yet (M2 / M3).
# Modes: off | prefer_local | local_only.
# COMIC_GCD_LOCAL_PATH=
# COMIC_GCD_LOCAL_MODE=off
# COMIC_COMICVINE_LOCAL_PATH=
# COMIC_COMICVINE_LOCAL_MODE=off

# ───── Metadata refresh, matching, coverage — first-boot bootstraps ─────
# Most are editable under /admin/metadata → Settings (the two marked
# "no UI" in docs/dev/metadata-operator-guide.md are PATCH-only). Weekly
# refresh is off by design (it spends provider quota); the cron string
# needs a restart.
# COMIC_METADATA_WEEKLY_REFRESH_ENABLED=false
# COMIC_METADATA_WEEKLY_REFRESH_CRON="0 0 4 * * 0"   # Sunday 04:00 UTC, 6-field
# COMIC_METADATA_WEEKLY_REFRESH_WINDOW_DAYS=14
# COMIC_METADATA_STALE_AFTER_DAYS=180
# Text-fallback match buckets (cover pHash decides first; docs/dev/matching-accuracy.md).
# COMIC_METADATA_AUTO_APPLY_THRESHOLD=80       # HIGH cutoff
# COMIC_METADATA_MATCH_MEDIUM_THRESHOLD=60     # MEDIUM cutoff
# COMIC_METADATA_ALTERNATE_COVER_FETCH_CAP=3   # variant covers hashed per candidate; 0 = primary only
# Comma-separated tiebreak order for composite merges; empty = metron,comicvine,gcd.
# COMIC_METADATA_MERGE_PROVIDER_PREFERENCE=
# Coverage analysis after a series match: off | manual_only | all.
# COMIC_METADATA_COVERAGE_AFTER_SERIES_APPLY=manual_only
# COMIC_METADATA_COVERAGE_AUTO_ACCEPT=false
# Issue-level refresh (direct lookups only, into a Review batch).
# COMIC_METADATA_ISSUE_REFRESH_ENABLED=false
# COMIC_METADATA_ISSUE_REFRESH_PER_PROVIDER_CAP=200   # 1–1000

# ───── Development tooling ─────
# When set (any value), the server loads `.env` from the working
# directory at boot. Defaults on for `cargo run` debug builds (so a
# self-hoster doesn't have to add it manually) and off for release
# builds. Leave unset in production; container deployments inject env
# directly via compose / k8s rather than from a `.env` file.
# COMIC_LOAD_DOTENV=1

# ───── Deployment (compose.prod.yml) ─────
# These drive `compose.prod.yml` placeholders; they have no effect on a
# local `cargo run` or `pnpm dev` session.

# GHCR owner/org that holds your published images:
#   ghcr.io/${REPO_OWNER}/folio        (Rust server)
#   ghcr.io/${REPO_OWNER}/folio-web    (Next.js frontend)
REPO_OWNER=your-github-username-or-org

# Image tag to deploy. Use `vX.Y` for hands-off patch upgrades, `vX.Y.Z`
# to pin exactly, `edge` to track main. Default is `latest`.
TAG=latest

# Postgres password for the `comic` user (compose initializes the DB on
# first boot with this value). Pick something long and random.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Absolute host path that holds your CBZ/CBR/PDF/EPUB library. Mounted
# read-only into the container at `${COMIC_LIBRARY_PATH}` (default
# `/library`). For path symmetry between dev (native binary) and prod
# (container), set both to the same value, e.g.:
#   COMIC_LIBRARY_HOST_PATH=/mnt/data
#   COMIC_LIBRARY_PATH=/mnt/data
COMIC_LIBRARY_HOST_PATH=/mnt/data

# Host interface for the published API port. Default is 127.0.0.1 so a
# reverse proxy on the same host is the only reachable entry point.
# Set to 0.0.0.0 on a trusted LAN (homelab) or when you also want a
# Cloudflare tunnel and direct LAN access to coexist. Leave at 127.0.0.1
# on a public-internet host — the API has no TLS of its own, so a proxy
# in front is mandatory there.
COMIC_APP_BIND=0.0.0.0

# `COMIC_WEB_BIND` is deprecated and ignored as of the M5 rust-public-
# origin cutover. `web` is internal-only on the compose bridge now; the
# Rust binary reverse-proxies HTML to it via `COMIC_WEB_UPSTREAM_URL`.
# You can delete this line; it's left here only to document the change
# for operators migrating from older versions.
# COMIC_WEB_BIND=0.0.0.0

# SSR upstream the Rust binary reverse-proxies HTML/static requests to.
# Set automatically in `compose.prod.yml` to `http://web:3000` over the
# compose bridge; only override here if your `web` service has a
# different name or port.
# COMIC_WEB_UPSTREAM_URL=http://web:3000

# ───── Observability ─────
# Bearer token gating GET /metrics in production/release builds. Prometheus
# scrape requests must send `Authorization: Bearer <token>`. For intentional
# unauthenticated production metrics behind a reverse proxy/network ACL, set
# COMIC_METRICS_OPEN=true explicitly. See docs/dev/metrics.md.
# COMIC_METRICS_TOKEN=
# COMIC_METRICS_OPEN=false
# Reserved for an OTLP trace exporter that is not wired: setting it only
# logs a "not shipped in v1" notice at boot (observability.rs; the
# Prometheus /metrics endpoint covers operator monitoring).
# COMIC_OTLP_ENDPOINT=

# Folio — production environment for compose.prod.yml
#
# Copy to `.env` next to compose.prod.yml and replace every placeholder.
# This file is for a compose deployment behind your own TLS reverse proxy.
# `.env.example` is the development file: do not use it for production.
#
# Everything not listed here either has a safe default in compose.prod.yml
# or the image, or is edited in the admin UI after first sign-in
# (/admin/auth, /admin/email, /admin/server, /admin/metadata).
#
# First run
# ---------
# 1. Fill in the values below and run
#    `docker compose -f compose.prod.yml up -d`.
#    Migrations run and server secrets are generated on first boot.
# 2. While registration is open and no account exists, the server logs a
#    WARN at boot: the first account to register becomes the admin.
#    Register your own account straight away at COMIC_PUBLIC_URL, before
#    you share the address with anyone.
# 3. Turn off "Self-serve registration" under /admin/auth. Add other
#    people under /admin/users, or turn it back on when you want it.
#
# COMIC_LOCAL_REGISTRATION_OPEN only matters on the first boot: it is
# copied into the database then, and the /admin/auth setting wins from
# then on. If it is unset on the first boot, registration starts closed
# and no one can create the first admin account, because nothing else
# creates one. Once registration is closed in /admin/auth you can delete
# the line.

# ───── Required ─────

# GitHub user or organization that publishes the images
# (ghcr.io/<REPO_OWNER>/folio and ghcr.io/<REPO_OWNER>/folio-web).
REPO_OWNER=your-github-user-or-org

# Password for the `comic` Postgres user. Set once, before the first boot:
# Postgres is initialized with it and does not pick up a later change.
POSTGRES_PASSWORD=replace-with-a-long-random-string

# Absolute host path of your comics. Mounted read-only into the container.
COMIC_LIBRARY_HOST_PATH=/path/to/your/comics

# The HTTPS address people open in the browser, as your reverse proxy
# serves it. Cookies, the CSP and OIDC redirect URIs are built from it.
COMIC_PUBLIC_URL=https://comics.example.com

# Lets the first visitor register (see "First run" above). Close
# registration under /admin/auth as soon as your admin account exists.
COMIC_LOCAL_REGISTRATION_OPEN=true

# ───── Optional ─────

# Image tag. `vX.Y` follows patch releases, `vX.Y.Z` pins one release,
# `edge` tracks main. Default: latest. See docs/install/upgrades.md.
# TAG=vX.Y

# Path the library is mounted at inside the container (default /library).
# Set it to the host path if you want both paths to match.
# COMIC_LIBRARY_PATH=/library

# Host interface for the app's plain-HTTP port 8080. Default 127.0.0.1, so
# only a reverse proxy or tunnel on the same host can reach it. 0.0.0.0
# publishes it on every interface; only do that on a trusted LAN, or when
# the proxy runs on another machine and a firewall limits who can connect.
# The app has no TLS of its own.
# COMIC_APP_BIND=127.0.0.1

# Addresses allowed to set X-Forwarded-For, so rate limits and lockouts see
# each client's real address. Leave unset: compose.prod.yml then uses
# 172.16.0.0/12, which covers a proxy in a Docker container and a proxy on
# the host connecting to 127.0.0.1:8080 (Docker hands those connections over
# from its bridge gateway). If your proxy connects from elsewhere, such as
# another machine or a Docker network outside that range, set its address or
# subnet as comma-separated CIDRs. Setting this replaces the default.
# COMIC_TRUSTED_PROXIES=192.168.1.10/32

# ───── Managed in the admin UI ─────
# Authentication (mode, OIDC, registration, token lifetimes): /admin/auth.
# With no sign-in mode chosen and no single sign-on configured, the server
# uses local (email and password) sign-in, so no COMIC_AUTH_MODE line is
# needed; pick a mode under /admin/auth when you add single sign-on.
# Email (SMTP): /admin/email. Log level, rate limiting and workers:
# /admin/server. The older COMIC_AUTH_MODE, COMIC_OIDC_*, COMIC_JWT_*,
# COMIC_SMTP_*, COMIC_RATE_LIMIT_ENABLED and COMIC_LOG_LEVEL variables are
# only copied into the database on the first boot, are ignored after that,
# and make the server log a deprecation WARN. Leave them out;
# docs/dev/environment.md and docs/install/ cover the rest.
